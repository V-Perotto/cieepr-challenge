# Copie para .env (cp .env.example .env). Valores válidos só para desenvolvimento local/Docker.

# Senha do usuário 'sa' do SQL Server. Precisa ter 8+ caracteres e 3 de: maiúscula, minúscula, dígito, símbolo.
# Senha abaixo é um exemplo, NÃO deve ser usada em produção.
MSSQL_SA_PASSWORD=Dev_Passw0rd!2026

# Host do SQL Server visto pelo backend: "db" no Docker Compose, "localhost" rodando fora do Docker.
DB_HOST=db
# Porta do SQL Server.
DB_PORT=1433
# Banco da aplicação; é criado automaticamente pelas migrations na inicialização do backend ('recrutamento' apenas em desenvolvimento).
DB_NAME=recrutamento
# Usuário do banco usado pelo backend ('sa' apenas em desenvolvimento).
DB_USER=sa
# Senha do DB_USER; igual a MSSQL_SA_PASSWORD enquanto usar o 'sa'.
# Senha abaixo é um exemplo, NÃO deve ser usada em produção.
DB_PASSWORD=Dev_Passw0rd!2026

# Porta HTTP da API.
PORT=3000
# Nível de log do backend (fatal, error, warn, info, debug, trace).
LOG_LEVEL=info
# Tempo máximo (ms) para ler um PDF antes de responder falha de leitura.
PDF_EXTRACTION_TIMEOUT_MS=4000
